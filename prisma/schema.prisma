generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id            BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  email         String               @unique(map: "email")
  password_hash String               @db.VarChar(255)
  full_name     String?              @db.VarChar(255)
  company_name  String?              @db.VarChar(150)
  role          users_role
  phone_no      String?              @db.VarChar(30)
  timezone      String?              @db.VarChar(100)
  device_type   users_device_type?   @default(WEB)
  notify_status users_notify_status? @default(OFF)
  created_at    DateTime             @default(now()) @db.DateTime(0)
  updated_at    DateTime             @default(now()) @db.DateTime(0)
  deleted_at    DateTime?            @db.DateTime(0)

  @@index([role], map: "idx_role")
}

enum users_role {
  ADMIN
  ACCOUNT_MANAGER
  CLIENT
  USER
}

enum users_device_type {
  ANDROID
  IOS
  WEB
}

enum users_notify_status {
  ON
  OFF
}
